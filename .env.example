# =================================================================
# SocialFlow AI — Environment Variables Template
# Copy this file to .env and fill in your real values.
# NEVER commit real secrets to version control.
# =================================================================

# ─── Hugging Face AI ──────────────────────────────────────────────
# Get your token from https://huggingface.co/settings/tokens
# Required for AI content generation to work
HF_TOKEN=your_huggingface_api_token_here

# ─── Database ─────────────────────────────────────────────────────
# DB_URL=jdbc:mysql://localhost:3306/socialflow
# DB_USER=socialflow_user
# DB_PASSWORD=socialflow123

# ─── JWT Secret ───────────────────────────────────────────────────
# JWT_SECRET=change_this_in_production_min_32_chars

# ─── Meta / Facebook Pages (ACTIVE) ──────────────────────────────
# 1. Go to https://developers.facebook.com/
# 2. Create app, add Facebook Login product
# 3. Get App ID and App Secret from Settings > Basic
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
META_REDIRECT_URI=http://localhost:8080/api/social-accounts/FACEBOOK/callback

# ─── Instagram Business Login (ACTIVE) ───────────────────────────
# 1. Go to https://developers.facebook.com/
# 2. Add "Instagram API with Instagram Login" / Instagram product
# 3. Get Instagram App ID and Client Secret
# 4. Set OAuth redirect URI (e.g. ngrok or production callback URL)
INSTAGRAM_CLIENT_ID=your_instagram_client_id
INSTAGRAM_CLIENT_SECRET=your_instagram_client_secret
INSTAGRAM_REDIRECT_URI=https://chewing-crock-reviving.ngrok-free.dev/api/social-accounts/INSTAGRAM/callback

# ─── Public Media Server Base URL (Required for Instagram publishing) ───
# Point to your publicly accessible ngrok domain or production backend URL (must be HTTPS)
PUBLIC_BASE_URL=https://chewing-crock-reviving.ngrok-free.dev


# ─── LinkedIn (ACTIVE) ────────────────────────────────────────────
# 1. Go to https://www.linkedin.com/developers/apps
# 2. Create app, add "Share on LinkedIn" product
# 3. Request scopes: openid, profile, w_member_social
# 4. Add redirect URI in Auth tab
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret
LINKEDIN_REDIRECT_URI=http://localhost:8080/api/social-accounts/LINKEDIN/callback

# ─── Google / YouTube ─────────────────────────────────────────────
# 1. Go to https://console.cloud.google.com/
# 2. Enable YouTube Data API v3
# 3. Create OAuth 2.0 credentials (Web application)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8080/api/social-accounts/YOUTUBE/callback

# ─── CORS ─────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
